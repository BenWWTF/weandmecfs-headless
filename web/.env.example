# --- Local dev defaults are baked into the code; no env file needed
#     to run scripts/dev.sh. Set these to point at a different WP
#     instance (staging, prod, etc.).

# Where the WordPress REST API lives. Local dev: http://localhost:8080.
# Production: https://www.weandmecfs.org
WP_BASE_URL=http://localhost:8080

# Site URL — used for canonical links, OpenGraph, sitemap.
SITE_URL=http://localhost:3000

# Secret shared with the WordPress plugin. Generate with:
#   openssl rand -hex 32
# Must match Settings → WE&ME Headless → Shared secret in wp-admin.
WEANDME_REVALIDATION_SECRET=replace-me-with-a-long-random-string

# Optional analytics
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
